# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
tile.pbf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents
/.agent/
/.agents/
.agents/.system_generated/
skills-lock.json

# playwright reports & results (e2e/ and playwright.config.ts are tracked source code!)
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# documentation (kept local, not part of lean code index)
/docs/
*.md

# local ops scripts
/scripts/

# database schema & e2e (kept local only, not part of lean code index)
/supabase/migrations/
/e2e/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Extra Security & DB runtime temps
*.sqlite
*.db
*.log
supabase/.temp/
